   "@graph": [
    {
      "@id" : "https://w3id.org/codemeta/terms/",
      "@type" : "schema:CreativeWork" ,
      "schema:dateCreated":"2017-01-06",
      "schema:dateModified":"2026-06-23",
      "schema:version":"4.0",
      "schema:schemaVersion":"https://schema.org/docs/releases.html#v30.0",
      "schema:name":"CodeMeta",
      "schema:license":{"@id":"https://spdx.org/licenses/Apache-2.0", "@type":"@id"},
      "schema:identifier": {"@id": "https://w3id.org/codemeta/terms/", "@type": "@id"},
      "schema:description": "CodeMeta provides a shared, minimal metadata vocabulary for software, designed to support research, discovery, citation, and interoperability across platforms."
     },
    {
      "@id": "codemeta:buildInstructions",
      "@type": "rdf:Property",
      "rdfs:comment": "A link to installation instructions or build documentation.",
      "rdfs:label": "buildInstructions",
      "schema:domainIncludes": [
        {
          "@id": "schema:SoftwareApplication"
        },
        {
          "@id": "schema:SoftwareSourceCode"
        }
      ],
      "schema:rangeIncludes": 
      [
        {
        "@id": "schema:URL"
        },
        {
        "@id": "schema:CreativeWork"
        }
      ]
    },
    {
      "@id": "codemeta:contIntegration",
      "@type": "rdf:Property",
      "rdfs:comment": "A link to continuous integration service.",
      "rdfs:label": "contiIntegration",
      "schema:domainIncludes": [
        {
          "@id": "schema:SoftwareApplication"
        },
        {
          "@id": "schema:SoftwareSourceCode"
        }
      ],
      "schema:rangeIncludes": {
        "@id": "schema:URL"
      },
      "schema:supersededBy": {
        "@id": "codemeta:continuousIntegration"
      }
    },
    {
      "@id": "codemeta:continuousIntegration",
      "@type": "rdf:Property",
      "rdfs:comment": "A link to continuous integration service.",
      "rdfs:label": "continuousIntegration",
      "schema:domainIncludes": [
        {
          "@id": "schema:SoftwareApplication"
        },
        {
          "@id": "schema:SoftwareSourceCode"
        }
      ],
      "schema:rangeIncludes": {
        "@id": "schema:URL"
      }
    },
    {
      "@id": "codemeta:developmentStatus",
      "@type": "rdf:Property",
      "rdfs:comment": "Description of development status, e.g. active, inactive, suspended. See repostatus.org.",
      "rdfs:label": "developmentStatus",
      "schema:domainIncludes": [
        {
          "@id": "schema:SoftwareApplication"
        },
        {
          "@id": "schema:SoftwareSourceCode"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:URL"
        },
        {
          "@id": "schema:DefinedTerm"
        },
        {
          "@id": "schema:Text"
        }
        
      ]
    },
    {
      "@id": "codemeta:embargoDate",
      "@type": "rdf:Property",
      "rdfs:comment": "Software may be embargoed from public access until a specified date (e.g. pending publication, 1 year from publication)",
      "rdfs:label": "embargoDate",
      "schema:domainIncludes": [
        {
          "@id": "schema:SoftwareSourceCode"
        },
        {
          "@id": "schema:SoftwareApplication"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Date"
        }
      ],
      "schema:supersededBy": {
        "@id": "codemeta:embargoEndDate"
      }
    },
    {
      "@id": "codemeta:embargoEndDate",
      "@type": "rdf:Property",
      "rdfs:comment": "Software may be embargoed from public access until a specified date (e.g. pending publication, 1 year from publication)",
      "rdfs:label": "embargoEndDate",
      "schema:domainIncludes": [
        {
          "@id": "schema:SoftwareSourceCode"
        },
        {
          "@id": "schema:SoftwareApplication"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Date"
        },
        {
          "@id": "schema:DateTime"
        }
      ]
    },
    {
      "@id": "codemeta:funding",
      "@type": "rdf:Property",
      "rdfs:comment": "Funding source (e.g. specific grant)",
      "rdfs:label": "funding",
      "schema:domainIncludes": [
        {
          "@id": "schema:SoftwareSourceCode"
        },
        {
          "@id": "schema:SoftwareApplication"
        }
      ],
      "schema:rangeIncludes": {
          "@id": "schema:Text"
      },
       "schema:supersededBy": {
        "@id": "schema:funding"
      }
    },
    {
      "@id": "codemeta:hasSourceCode",
      "@type": "rdf:Property",
      "rdfs:comment": "A link that states where the software code is for a given software. For example a software registry may indicate that one of its software entries hasSourceCode in a GitHub repository.",
      "rdfs:label": "hasSourceCode",
      "schema:domainIncludes": 
      {
        "@id": "schema:SoftwareApplication"
      }
      ,
      "schema:rangeIncludes": {
          "@id": "schema:SoftwareSourceCode"
      }
    },
    {
      "@id": "codemeta:isSourceCodeOf",
      "@type": "rdf:Property",
      "rdfs:comment": "A link that states where software application is built from a given source code. This is the inverse property of 'hasSourceCode'.",
      "rdfs:label": "isSourceCodeOf",
      "schema:domainIncludes": {
          "@id": "schema:SoftwareSourceCode"
      },
      "schema:rangeIncludes": 
      {
        "@id": "schema:SoftwareApplication"
      }
    },
    {
      "@id": "codemeta:issueTracker",
      "@type": "rdf:Property",
      "rdfs:comment": "A link to software bug reporting or issue tracking system.",
      "rdfs:label": "issueTracker",
      "schema:domainIncludes": [
        {
          "@id": "schema:SoftwareSourceCode"
        },
        {
          "@id": "schema:SoftwareApplication"
        }
      ],
      "schema:rangeIncludes": 
      {
        "@id": "schema:URL"
      }
    },
    {
      "@id": "codemeta:maintainer",
      "@type": "rdf:Property",
      "rdfs:comment": "Individual responsible for maintaining the software (usually includes an email contact address).",
      "rdfs:label": "maintainer",
      "schema:domainIncludes": [
        {
          "@id": "schema:SoftwareSourceCode"
        },
        {
          "@id": "schema:SoftwareApplication"
        }
      ],
      "schema:rangeIncludes": 
      {
        "@id": "schema:Person"
      },
      "schema:supersededBy": {
        "@id": "schema:maintainer"
      }
    },
    {
      "@id": "codemeta:readme",
      "@type": "rdf:Property",
      "rdfs:comment": "A link to software Readme file.",
      "rdfs:label": "readme",
      "schema:domainIncludes": 
      {
        "@id": "schema:SoftwareSourceCode"
      },
      "schema:rangeIncludes": 
      {
        "@id": "schema:URL"
      }
    },
    {
      "@id": "codemeta:referencePublication",
      "@type": "rdf:Property",
      "rdfs:comment": "An academic publication related to the software component.",
      "rdfs:label": "referencePublication",
      "schema:domainIncludes": 
      {
        "@id": "schema:SoftwareSourceCode"
      },
      "schema:rangeIncludes": 
      {
        "@id": "schema:ScholarlyArticle"
      }
    },
    {
      "@id": "codemeta:relatedSoftware",
      "@type": "rdf:Property",
      "rdfs:comment": "A link to other software that is related by functionality, scientific purpose, or ecosystem context (e.g. alternative implementations, comparable tools, or complementary software). This property does not imply dependency, citation, or execution requirement. It is intended to support discovery, comparison, and interoperability mapping between software artifacts.",
      "rdfs:label": "relatedSoftware",
      "schema:domainIncludes": [
        {
          "@id": "schema:SoftwareSourceCode"
        },
        {
          "@id": "schema:SoftwareApplication"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:SoftwareSourceCode"
        },
        {
          "@id": "schema:SoftwareApplication"
        }
      ]
    },
    {
      "@id": "codemeta:documentation",
      "@type": "rdf:Property",
      "rdfs:comment": "A general property for linking to any form of software documentation, including but not limited to user guides, tutorials, help pages, manuals, and reference documentation. ",
      "rdfs:label": "documentation",
      "schema:domainIncludes": [
        {
          "@id": "schema:SoftwareApplication"
        },
        {
          "@id": "schema:SoftwareSourceCode"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:CreativeWork"
        },
        {
          "@id": "schema:URL"
        }
      ]
    },
    {
      "@id": "codemeta:citeAsID",
      "@type": "rdf:Property",
      "rdfs:comment": "A permanent identifier to a specific citable version of the software",
      "rdfs:label": "citeAsID",
      "schema:domainIncludes": [
        {
          "@id": "schema:SoftwareApplication"
        },
        {
          "@id": "schema:SoftwareSourceCode"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:String"
        },
        {
          "@id": "schema:URL"
        }
      ]
    },
    {
      "@id": "codemeta:citeWith",
      "@type": "rdf:Property",
      "rdfs:comment": "Companion works that should be cited with the version of this software",
      "rdfs:label": "citeWith",
      "schema:domainIncludes": [
        {
          "@id": "schema:SoftwareApplication"
        },
        {
          "@id": "schema:SoftwareSourceCode"
        }
      ],
      "schema:rangeIncludes": 
      {
        "@id": "schema:CreativeWork"
      }
    }
  ]
}
